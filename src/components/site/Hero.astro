---
/*
 * Centered hero (S4) flanked by two decorative ASCII silhouettes (S5).
 * The canvas engine lives in src/scripts/ascii-tiles.js and paints inside
 * the .dot-tile spans; everything here is content-free decoration.
 */
---

<section class="hero">
	<div class="hero-tiles" aria-hidden="true">
		<span class="dot-tile"></span>
		<span class="dot-tile"></span>
	</div>
	<div class="hero-copy">
		<h1><span data-i18n-html="hero.title">A quiet place for <em>your files</em>.</span></h1>
		<p class="lede" data-i18n="hero.lede">
			Most clouds rent you a drawer in someone else's building. CloudLocal gives you the whole
			house: a calm, fast file cloud that runs on the computer already humming in your closet.
		</p>
		<div class="hero-cta">
			<a class="btn-primary btn-lg" href="https://github.com/AlexisVarela2811/CloudLocal/releases/latest" data-i18n="hero.download">Download free</a>
		</div>
		<a class="hero-gh" href="https://github.com/AlexisVarela2811/CloudLocal">
			<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
				<path
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
			</svg>
			<span data-i18n="hero.github">View the code on GitHub</span>
		</a>
	</div>
</section>
<script src="../../scripts/ascii-tiles.js"></script>

<style>
	.hero { position: relative; max-width: 1100px; margin: 0 auto; padding: 6.5rem 4rem 4rem; text-align: center; }
	.hero-copy { position: relative; z-index: 1; }
	h1 {
		font-size: clamp(2.5rem, 5.2vw, 3.6rem); font-weight: 700; letter-spacing: -.035em;
		line-height: 1.06; max-width: 16ch; margin: 0 auto 1.3rem;
	}
	h1 :global(em) { font-style: normal; color: var(--accent); }
	.lede { font-size: 1.05rem; line-height: 1.6; color: var(--muted); max-width: 46ch; margin: 0 auto; }
	.hero-cta { margin-top: 2.2rem; }
	.hero-cta :global(.btn-primary) { margin-inline: auto; }

	@media (max-width: 900px) {
		.hero { padding: 4.5rem 1.5rem 3rem; }
	}
</style>
