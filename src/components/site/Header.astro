---
/*
 * Site header: wordmark + logo, language selector, plain Download link and a
 * GitHub stars pill (S3). The content shares the centered width with the footer.
 * The star count is fetched from the GitHub API at build time so it is always
 * the real number; if the fetch fails the pill degrades to "GitHub stars".
 */
const REPO = 'https://github.com/AlexisVarela2811/CloudLocal';
let stars = null;
try {
	const res = await fetch('https://api.github.com/repos/AlexisVarela2811/CloudLocal', {
		headers: { 'User-Agent': 'cloudlocal-landing-build' }
	});
	if (res.ok) {
		const data = await res.json();
		if (typeof data.stargazers_count === 'number') stars = data.stargazers_count;
	}
} catch {
	/* offline build: fall back to the count-less pill */
}
---

<header class="site-width">
	<div class="brand">
		<svg viewBox="0 0 100 80" fill="none" role="img" aria-label="CloudLocal logo">
			<defs>
				<linearGradient id="brandCloud" x1="0" y1="0" x2="100" y2="80" gradientUnits="userSpaceOnUse">
					<stop offset="0%" stop-color="#2563eb" />
					<stop offset="40%" stop-color="#3b82f6" />
					<stop offset="70%" stop-color="#f59e0b" />
					<stop offset="100%" stop-color="#fbbf24" />
				</linearGradient>
			</defs>
			<path
				d="M28 58 Q18 58 18 50 Q18 42 26 40 Q28 28 38 24 Q42 16 52 16 Q62 16 66 24 Q76 20 84 28 Q92 32 92 42 Q92 50 84 52 L84 56 Q84 58 82 58 Z"
				fill="url(#brandCloud)" stroke="white" stroke-width="2.5" stroke-linejoin="round" />
			<path d="M34 52 Q30 52 30 46 Q30 40 36 38 Q38 30 44 28 Q48 24 52 26 Q50 32 48 40 Q44 48 52 52 Z" fill="white" opacity="0.25" />
		</svg>
		CloudLocal
	</div>
	<nav aria-label="Primary navigation">
		<button type="button" class="site-theme" data-site-theme-toggle aria-label="Page theme" aria-pressed="false" title="Page theme">
			<svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" /></svg>
			<svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
		</button>
		<select class="lang-select" aria-label="Language / Idioma">
			<option value="en">EN</option>
			<option value="es">ES</option>
		</select>
		<a class="dl-link" href="https://github.com/AlexisVarela2811/CloudLocal/releases/latest" data-i18n="nav.download">Download</a>
		<a class="stars" href="https://github.com/AlexisVarela2811/CloudLocal">
			<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
				<path d="M8 1.4l1.94 3.93 4.33.63-3.13 3.05.74 4.31L8 11.29l-3.88 2.03.74-4.31L1.73 5.96l4.33-.63z" />
			</svg>
			{stars === null ? 'GitHub stars' : `${stars.toLocaleString('en-US')} ${stars === 1 ? 'GitHub star' : 'GitHub stars'}`}
		</a>
	</nav>
</header>

<script src="../../scripts/site-theme.js"></script>

<style>
	header {
		display: flex; align-items: center; justify-content: space-between;
		padding-block: .9rem; border-bottom: 1px solid var(--line);
		background: var(--surface); position: sticky; top: 0; z-index: 10;
		box-shadow: 0 1px 3px rgba(0, 0, 0, .04), 0 1px 2px rgba(0, 0, 0, .03);
	}
	.brand { display: flex; align-items: center; gap: .55rem; font-size: 1.08rem; font-weight: 700; letter-spacing: -.02em; }
	.brand svg { width: 26px; height: 21px; display: block; }
	.site-theme { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text); cursor: pointer; flex-shrink: 0; }
	.site-theme svg { width: 16px; height: 16px; }
	.site-theme .theme-sun { display: none; }
	:global(html[data-theme="dark"]) .site-theme .theme-sun { display: block; }
	:global(html[data-theme="dark"]) .site-theme .theme-moon { display: none; }
	:global(html[data-theme="dark"]) .stars { color: var(--accent3); }
	.site-theme:focus-visible { outline: 2px solid var(--accent2); outline-offset: 2px; }
	nav { display: flex; align-items: center; gap: 1rem; }
	.dl-link { color: var(--muted); text-decoration: none; font-size: .82rem; font-weight: 500; transition: color var(--ease) var(--duration); }
	.dl-link:hover { color: var(--text); }
	.stars {
		display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; text-decoration: none;
		font: 500 .78rem 'Inter', system-ui, sans-serif; color: #0f766e;
		background: rgba(20, 184, 166, .12); border: 1px solid rgba(13, 148, 136, .3);
		border-radius: 20px; padding: .34rem .8rem .34rem .68rem;
		transition: background var(--ease) var(--duration), border-color var(--ease) var(--duration);
	}
	.stars svg { width: 12px; height: 12px; color: #f59e0b; flex-shrink: 0; }
	.stars:hover { background: rgba(20, 184, 166, .22); border-color: rgba(13, 148, 136, .5); }
	.lang-select {
		color: var(--muted); background: transparent; border: 1px solid var(--line);
		border-radius: var(--radius-sm); padding: .3rem; font: inherit; font-size: .75rem;
	}

	@media (max-width: 480px) {
		header { gap: .35rem; flex-wrap: wrap; }
		.brand { font-size: .9rem; gap: .3rem; }
		.brand svg { width: 22px; }
		nav { gap: .35rem; }
		.dl-link { font-size: .72rem; }
		.stars { font-size: .62rem; padding-inline: .35rem; }
		.lang-select { font-size: .68rem; padding: .2rem; }
	}
</style>
